# Copie para deploy/.env e ajuste. Banco, JWT, admin e Supabase ficam no backend/.env (fora do git).

# Portas publicadas no host
BACKEND_PORT=5432
FRONTEND_PORT=4200

# Front-end: endereço da API visto pelo NAVEGADOR. "/api" = passa pelo nginx do front (recomendado)
API_URL=/api
# Back-end: origens autorizadas a chamar a API (endereço do front-end), separadas por vírgula
CORS_ORIGINS=http://localhost:4200
